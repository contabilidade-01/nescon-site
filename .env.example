# Configure estas variáveis no painel da Netlify (Site configuration → Environment variables)

# Envio de e-mails (https://resend.com) — lembretes de abandono e avisos de novos leads
RESEND_API_KEY=
# Remetente com domínio verificado no Resend, ex.: Nescon Contabilidade <contato@nescon.com.br>
EMAIL_REMETENTE=
# Quem recebe os avisos de leads (pode separar vários por vírgula)
EMAIL_EQUIPE=

# Senha de acesso ao painel de leads em /painel
PAINEL_SENHA=
