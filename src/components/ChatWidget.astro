---
import { escritorio, whatsappLink } from "../config/site";
---

<div id="chat" class="fixed bottom-4 right-4 z-50 flex flex-col items-end gap-3 print:hidden">
  <section
    id="chat-painel"
    hidden
    role="dialog"
    aria-modal="false"
    aria-labelledby="chat-titulo"
    class="flex h-[min(560px,calc(100dvh-6rem))] w-[min(380px,calc(100vw-2rem))] flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl"
  >
    <header class="flex items-center justify-between bg-marinho-800 px-4 py-3 text-white">
      <div>
        <p id="chat-titulo" class="font-semibold">Fale com a {escritorio.nome}</p>
        <p class="text-xs text-marinho-100">Assistente virtual + equipe de contadores</p>
      </div>
      <button type="button" data-fechar-chat class="rounded-lg p-1 hover:bg-white/10" aria-label="Fechar conversa">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </header>

    <ol id="chat-mensagens" class="flex-1 space-y-3 overflow-y-auto bg-areia p-4 text-sm" aria-live="polite">
      <li class="max-w-[85%] rounded-2xl rounded-tl-sm bg-white p-3 shadow-sm">
        Olá! 👋 Sou o assistente virtual da {escritorio.nome}. Me conte o que você precisa e eu já te encaminho para um contador da equipe.
      </li>
    </ol>

    <div id="chat-sugestoes" class="flex flex-wrap gap-2 border-t border-slate-100 px-4 py-3">
      <button type="button" data-sugestao class="rounded-full border border-marinho-600/30 px-3 py-1 text-xs text-marinho-800 hover:bg-marinho-50">Quero abrir uma empresa</button>
      <button type="button" data-sugestao class="rounded-full border border-marinho-600/30 px-3 py-1 text-xs text-marinho-800 hover:bg-marinho-50">Sou MEI e estou crescendo</button>
      <button type="button" data-sugestao class="rounded-full border border-marinho-600/30 px-3 py-1 text-xs text-marinho-800 hover:bg-marinho-50">Quero trocar de contador</button>
      <a href={whatsappLink()} target="_blank" rel="noopener" data-evento="whatsapp_direto" class="rounded-full bg-destaque-600 px-3 py-1 text-xs font-semibold text-white hover:bg-destaque-700">Falar com uma pessoa</a>
    </div>

    <form id="chat-form" class="flex gap-2 border-t border-slate-200 p-3">
      <label for="chat-entrada" class="sr-only">Sua mensagem</label>
      <input id="chat-entrada" name="mensagem" autocomplete="off" maxlength="800" required placeholder="Digite sua mensagem…" class="min-w-0 flex-1 rounded-full border border-slate-300 px-4 py-2 text-sm focus:border-marinho-600 focus:outline-none" />
      <button type="submit" class="rounded-full bg-marinho-800 px-4 text-sm font-semibold text-white hover:bg-marinho-700 disabled:opacity-50">Enviar</button>
    </form>
    <p class="px-3 pb-2 text-[11px] leading-snug text-slate-500">
      O assistente usa IA e pode errar; orientações definitivas vêm do contador. Ao conversar, você concorda com nossa <a href="/politica-de-privacidade" class="underline">política de privacidade</a>.
    </p>
  </section>

  <button
    type="button"
    id="chat-botao"
    data-abrir-chat
    class="flex items-center gap-2 rounded-full bg-destaque-600 px-5 py-3 font-semibold text-white shadow-lg hover:bg-destaque-700"
    aria-controls="chat-painel"
    aria-expanded="false"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z" /></svg>
    <span>Fale com um contador</span>
  </button>
</div>

<script define:vars={{ whatsappFallback: whatsappLink() }}>
  const painel = document.getElementById("chat-painel");
  const botao = document.getElementById("chat-botao");
  const lista = document.getElementById("chat-mensagens");
  const form = document.getElementById("chat-form");
  const entrada = document.getElementById("chat-entrada");
  const sugestoes = document.getElementById("chat-sugestoes");
  const CHAVE = "nescon-chat";

  let historico = [];
  let aguardando = false;
  try {
    historico = JSON.parse(sessionStorage.getItem(CHAVE) || "[]");
  } catch {
    historico = [];
  }

  const evento = (nome, params) => window.nesconEvento?.(nome, params);

  function salvar() {
    try {
      sessionStorage.setItem(CHAVE, JSON.stringify(historico.slice(-20)));
    } catch {
      /* armazenamento indisponível: a conversa só não é lembrada */
    }
  }

  function adicionarBolha(papel, texto) {
    const li = document.createElement("li");
    li.className =
      papel === "user"
        ? "ml-auto max-w-[85%] rounded-2xl rounded-tr-sm bg-marinho-800 p-3 text-white"
        : "max-w-[85%] whitespace-pre-line rounded-2xl rounded-tl-sm bg-white p-3 shadow-sm";
    li.textContent = texto;
    lista.appendChild(li);
    lista.scrollTop = lista.scrollHeight;
    return li;
  }

  function adicionarBotaoWhatsapp(url, rotulo) {
    const li = document.createElement("li");
    const a = document.createElement("a");
    a.href = url;
    a.target = "_blank";
    a.rel = "noopener";
    a.className = "inline-flex items-center gap-2 rounded-full bg-destaque-600 px-4 py-2 font-semibold text-white hover:bg-destaque-700";
    a.textContent = rotulo;
    a.addEventListener("click", () => evento("whatsapp_clique", { origem: "chat" }));
    li.appendChild(a);
    lista.appendChild(li);
    lista.scrollTop = lista.scrollHeight;
  }

  function abrir() {
    painel.hidden = false;
    botao.setAttribute("aria-expanded", "true");
    botao.classList.add("hidden");
    entrada.focus();
    evento("chat_aberto", { pagina: location.pathname });
  }

  function fechar() {
    painel.hidden = true;
    botao.setAttribute("aria-expanded", "false");
    botao.classList.remove("hidden");
  }

  function registrarLead(lead) {
    const dados = new URLSearchParams({ "form-name": "lead-chat", pagina: location.pathname, ...lead });
    fetch("/", { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: dados.toString() }).catch(() => {});
  }

  async function enviar(texto) {
    if (aguardando || !texto.trim()) return;
    aguardando = true;
    sugestoes.hidden = true;
    adicionarBolha("user", texto);
    historico.push({ role: "user", content: texto });
    salvar();
    const digitando = adicionarBolha("assistant", "Digitando…");
    form.querySelector("button").disabled = true;

    try {
      const resp = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages: historico, pagina: location.pathname }),
      });
      if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
      const dados = await resp.json();
      digitando.textContent = dados.resposta;
      historico.push({ role: "assistant", content: dados.resposta });
      salvar();
      if (dados.whatsapp) {
        adicionarBotaoWhatsapp(dados.whatsapp, "Continuar no WhatsApp com a equipe");
        if (dados.lead) registrarLead(dados.lead);
        evento("lead_qualificado", { necessidade: dados.lead?.necessidade || "" });
      }
    } catch {
      digitando.textContent = "Não consegui responder agora. Mas nossa equipe está no WhatsApp para te atender:";
      historico.pop();
      salvar();
      adicionarBotaoWhatsapp(whatsappFallback, "Falar com a equipe no WhatsApp");
    } finally {
      aguardando = false;
      form.querySelector("button").disabled = false;
      entrada.focus();
    }
  }

  // Restaura a conversa da sessão ao navegar entre páginas
  for (const m of historico) adicionarBolha(m.role, m.content);
  if (historico.length) sugestoes.hidden = true;

  document.addEventListener("click", (e) => {
    const alvo = e.target instanceof Element ? e.target : null;
    if (alvo?.closest("[data-abrir-chat]")) abrir();
    else if (alvo?.closest("[data-fechar-chat]")) fechar();
    else if (alvo?.closest("[data-sugestao]")) enviar(alvo.closest("[data-sugestao]").textContent.trim());
    else if (alvo?.closest("[data-evento]")) evento(alvo.closest("[data-evento]").dataset.evento, { pagina: location.pathname });
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !painel.hidden) fechar();
  });

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const texto = entrada.value;
    entrada.value = "";
    enviar(texto);
  });
</script>
