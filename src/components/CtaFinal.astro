---
import { whatsappLink } from "../config/site";
interface Props {
  titulo?: string;
  texto?: string;
}
const {
  titulo = "Vamos conversar sobre a sua empresa?",
  texto = "Conte o que você precisa. Um contador da equipe responde com os próximos passos, sem compromisso.",
} = Astro.props;
---

<section class="container-site mt-24">
  <div class="rounded-3xl bg-marinho-800 px-6 py-12 text-center text-white sm:px-12">
    <h2 class="text-3xl font-bold text-white">{titulo}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-marinho-100">{texto}</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <button type="button" data-abrir-chat class="btn-primario">Fale com um contador</button>
      <a href={whatsappLink()} target="_blank" rel="noopener" class="btn-claro">Chamar no WhatsApp</a>
    </div>
  </div>
</section>
