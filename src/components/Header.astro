---
import { nav, siteName } from "../config/site";
const atual = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/95 backdrop-blur">
  <div class="container-site flex h-16 items-center justify-between gap-8">
    <a href="/" class="flex items-center gap-2 font-bold text-marinho-900" aria-label={`${siteName} - página inicial`}>
      <img src="/favicon.svg" alt="" width="32" height="32" />
      <span class="whitespace-nowrap text-lg">{siteName}</span>
    </a>
    <nav aria-label="Principal" class="hidden xl:block">
      <ul class="flex items-center gap-5 whitespace-nowrap text-sm font-medium text-slate-700">
        {nav.map((item) => (
          <li>
            <a href={item.href} class:list={["hover:text-marinho-700", atual.startsWith(item.href) && "text-marinho-700 underline underline-offset-8"]}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <button type="button" data-abrir-chat class="btn-primario hidden whitespace-nowrap px-5 py-2 text-sm sm:inline-flex">Fale com um contador</button>
      <details class="relative xl:hidden">
        <summary class="list-none rounded-lg p-2 text-marinho-900 hover:bg-marinho-50 [&::-webkit-details-marker]:hidden" aria-label="Abrir menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        </summary>
        <nav aria-label="Menu móvel" class="absolute right-0 mt-2 w-64 rounded-2xl border border-slate-200 bg-white p-3 shadow-lg">
          <ul class="flex flex-col text-base">
            {nav.map((item) => <li><a href={item.href} class="block rounded-lg px-3 py-2 hover:bg-marinho-50">{item.label}</a></li>)}
            <li><a href="/contato" class="block rounded-lg px-3 py-2 hover:bg-marinho-50">Contato</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
