---
import { escritorio, whatsappLink } from "../config/site";
---

<div id="qualificacao" class="fixed bottom-4 right-4 z-50 flex flex-col items-end gap-3 print:hidden">
  <section
    id="q-painel"
    hidden
    role="dialog"
    aria-modal="false"
    aria-labelledby="q-titulo"
    class="flex h-[min(600px,calc(100dvh-6rem))] w-[min(390px,calc(100vw-2rem))] flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl"
  >
    <header class="bg-marinho-800 px-4 pb-3 pt-3 text-white">
      <div class="flex items-center justify-between">
        <div>
          <p id="q-titulo" class="font-semibold">Fale com um contador</p>
          <p class="text-xs text-marinho-100">Responda rapidinho e a equipe te chama no WhatsApp</p>
        </div>
        <button type="button" data-fechar-chat class="rounded-lg p-1 hover:bg-white/10" aria-label="Fechar">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
      <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-white/15" aria-hidden="true">
        <div id="q-progresso" class="h-full w-0 rounded-full bg-destaque-500 transition-all duration-300"></div>
      </div>
    </header>

    <ol id="q-mensagens" class="flex-1 space-y-3 overflow-y-auto bg-areia p-4 text-sm" aria-live="polite"></ol>

    <div id="q-acoes" class="border-t border-slate-200 bg-white p-3"></div>

    <div class="flex items-center justify-between gap-2 px-3 pb-2 text-[11px] text-slate-500">
      <button type="button" id="q-voltar" class="underline disabled:invisible">← Voltar</button>
      <a href={whatsappLink()} target="_blank" rel="noopener" data-evento="whatsapp_direto" class="underline">Prefere o WhatsApp direto?</a>
    </div>
    <p class="px-3 pb-2 text-[11px] leading-snug text-slate-500">
      Suas respostas são salvas automaticamente e usadas só para este atendimento. <a href="/politica-de-privacidade" class="underline">Privacidade</a>.
    </p>
  </section>

  <button
    type="button"
    id="q-botao"
    data-abrir-chat
    class="flex items-center gap-2 rounded-full bg-destaque-600 px-5 py-3 font-semibold text-white shadow-lg hover:bg-destaque-700"
    aria-controls="q-painel"
    aria-expanded="false"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z" /></svg>
    <span>Fale com um contador</span>
  </button>
</div>

<template id="q-dados" data-whatsapp={escritorio.whatsapp} data-nome={escritorio.nome}></template>

<script>
  import {
    formatarWhatsapp,
    prazoRetorno,
    primeiroNome,
    proximaPergunta,
    recomendar,
    resumo,
    roteiro,
    rotuloResposta,
    trilhaPorId,
    validarResposta,
    contatoCompleto,
    type Pergunta,
    type Respostas,
  } from "../config/qualificacao";

  type Estado = { respostas: Respostas; id?: string; token?: string; concluido?: boolean; confirmado?: boolean };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const painel = $("q-painel");
  const botao = $<HTMLButtonElement>("q-botao");
  const lista = $("q-mensagens");
  const acoes = $("q-acoes");
  const voltar = $<HTMLButtonElement>("q-voltar");
  const progresso = $("q-progresso");
  const dados = $("q-dados").dataset;
  const CHAVE = "nescon-qualificacao";

  const evento = (nome: string, params: Record<string, string> = {}) =>
    (window as unknown as { nesconEvento?: (n: string, p: Record<string, string>) => void }).nesconEvento?.(nome, params);

  function carregar(): Estado {
    try {
      const e = JSON.parse(localStorage.getItem(CHAVE) || "null");
      if (e && typeof e.respostas === "object") return e;
    } catch {
      /* armazenamento indisponível */
    }
    return { respostas: {} };
  }

  let estado = carregar();
  let fila: Promise<unknown> = Promise.resolve();

  function guardar() {
    try {
      localStorage.setItem(CHAVE, JSON.stringify(estado));
    } catch {
      /* sem armazenamento local: o servidor ainda guarda as respostas */
    }
  }

  /** Salva no servidor em fila, para nunca criar dois leads para a mesma pessoa. */
  function sincronizar(concluido = false) {
    if (!contatoCompleto(estado.respostas)) return fila;
    fila = fila
      .then(async () => {
        const resp = await fetch("/api/lead", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            id: estado.id,
            token: estado.token,
            respostas: estado.respostas,
            concluido,
            pagina: location.pathname,
            site: (document.getElementById("q-site") as HTMLInputElement | null)?.value ?? "",
          }),
        });
        if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
        const r = await resp.json();
        estado.id = r.id;
        estado.token = r.token;
        estado.confirmado = r.status === "completo";
        guardar();
      })
      .catch(() => {
        /* sem conexão: tenta de novo na próxima resposta */
      });
    return fila;
  }

  function bolha(papel: "equipe" | "pessoa", texto: string, ajuda?: string) {
    const li = document.createElement("li");
    li.className =
      papel === "pessoa"
        ? "ml-auto w-fit max-w-[85%] rounded-2xl rounded-tr-sm bg-marinho-800 px-3 py-2 text-white"
        : "max-w-[88%] rounded-2xl rounded-tl-sm bg-white p-3 shadow-sm";
    const p = document.createElement("p");
    p.textContent = texto;
    li.appendChild(p);
    if (ajuda) {
      const a = document.createElement("p");
      a.className = "mt-1.5 border-l-2 border-destaque-500 pl-2 text-xs leading-snug text-slate-600";
      a.textContent = ajuda;
      li.appendChild(a);
    }
    lista.appendChild(li);
    return li;
  }

  function textoPergunta(p: Pergunta) {
    if (p.id === "trilha") return `Prazer, ${primeiroNome(estado.respostas.nome)}! Como podemos ajudar?`;
    return p.texto;
  }

  function responder(p: Pergunta, bruto: string, erroEl?: HTMLElement) {
    const r = validarResposta(p, bruto);
    if ("erro" in r) {
      if (erroEl) erroEl.textContent = r.erro;
      return;
    }
    estado.respostas = { ...estado.respostas, [p.id]: r.valor };
    guardar();
    if (p.id === "whatsapp") evento("contato_salvo");
    if (p.id === "trilha") evento("trilha_escolhida", { trilha: r.valor });
    const fim = !proximaPergunta(estado.respostas);
    if (fim) {
      estado.concluido = true;
      guardar();
      evento("qualificacao_concluida", { trilha: estado.respostas.trilha ?? "" });
    }
    sincronizar(fim);
    renderizar();
  }

  function mostrarOpcoes(p: Pergunta) {
    const grade = document.createElement("div");
    grade.className = "flex flex-wrap gap-2";
    for (const o of p.opcoes ?? []) {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "rounded-full border border-marinho-600/40 bg-white px-3 py-2 text-left text-sm text-marinho-800 hover:border-destaque-600 hover:bg-marinho-50";
      b.textContent = o.rotulo;
      b.addEventListener("click", () => responder(p, o.valor));
      grade.appendChild(b);
    }
    acoes.appendChild(grade);
    (grade.firstElementChild as HTMLElement | null)?.focus({ preventScroll: true });
  }

  function mostrarCampo(p: Pergunta) {
    const form = document.createElement("form");
    form.className = "flex flex-col gap-1";
    form.noValidate = true;
    const linha = document.createElement("div");
    linha.className = "flex gap-2";
    const campo: HTMLInputElement | HTMLTextAreaElement = document.createElement(p.max && p.max > 200 ? "textarea" : "input");
    campo.name = p.id;
    campo.required = !p.opcional;
    campo.placeholder = p.placeholder ?? "";
    campo.maxLength = p.max ?? 200;
    campo.setAttribute("aria-label", p.texto);
    campo.className = "min-w-0 flex-1 rounded-2xl border border-slate-300 px-4 py-2 text-sm focus:border-marinho-600 focus:outline-none";
    if (campo instanceof HTMLInputElement) {
      const tipos = { nome: ["text", "name", "text"], email: ["email", "email", "email"], whatsapp: ["tel", "tel", "tel"] } as const;
      const [type, autocomplete, inputMode] = p.formato ? tipos[p.formato] : (["text", "off", "text"] as const);
      Object.assign(campo, { type, autocomplete, inputMode });
      if (p.formato === "whatsapp") {
        campo.addEventListener("input", () => {
          const d = campo.value.replace(/\D/g, "").slice(0, 11);
          campo.value = d.length > 6 ? `(${d.slice(0, 2)}) ${d.slice(2, d.length - 4)}-${d.slice(-4)}` : d.length > 2 ? `(${d.slice(0, 2)}) ${d.slice(2)}` : d;
        });
      }
    } else {
      campo.rows = 2;
    }
    const enviar = document.createElement("button");
    enviar.type = "submit";
    enviar.className = "rounded-full bg-marinho-800 px-4 text-sm font-semibold text-white hover:bg-marinho-700";
    enviar.textContent = "Enviar";
    linha.append(campo, enviar);
    const erro = document.createElement("p");
    erro.className = "min-h-4 text-xs text-red-700";
    erro.setAttribute("role", "alert");
    form.append(linha, erro);
    if (p.opcional) {
      const pular = document.createElement("button");
      pular.type = "button";
      pular.className = "self-start text-xs text-slate-500 underline";
      pular.textContent = "Pular";
      pular.addEventListener("click", () => responder(p, ""));
      form.appendChild(pular);
    }
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      responder(p, campo.value, erro);
    });
    // Campo invisível contra spam
    if (p.id === "nome") form.insertAdjacentHTML("beforeend", '<input id="q-site" name="site" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true">');
    acoes.appendChild(form);
    campo.focus({ preventScroll: true });
  }

  function mostrarConclusao() {
    const r = estado.respostas;
    const recomendacao = recomendar(r);
    if (recomendacao) bolha("equipe", recomendacao);
    bolha(
      "equipe",
      `Pronto, ${primeiroNome(r.nome)}! ✅ Um contador da nossa equipe vai te chamar no WhatsApp ${formatarWhatsapp(r.whatsapp ?? "")} ${prazoRetorno()}. Também enviamos um resumo para ${r.email}.`,
    );
    const texto = [`Olá! Acabei de falar com vocês pelo site da ${dados.nome}.`, ...resumo(r).filter((l) => !["E-mail", "WhatsApp"].includes(l.rotulo)).map((l) => `${l.rotulo}: ${l.valor}`)].join("\n");
    const a = document.createElement("a");
    a.href = `https://wa.me/${dados.whatsapp}?text=${encodeURIComponent(texto)}`;
    a.target = "_blank";
    a.rel = "noopener";
    a.className = "btn-primario w-full text-sm";
    a.textContent = "Quero falar agora no WhatsApp";
    a.addEventListener("click", () => evento("whatsapp_clique", { origem: "qualificacao" }));
    const reiniciar = document.createElement("button");
    reiniciar.type = "button";
    reiniciar.className = "mt-2 w-full text-xs text-slate-500 underline";
    reiniciar.textContent = "Começar um novo atendimento";
    reiniciar.addEventListener("click", () => {
      estado = { respostas: {} };
      guardar();
      renderizar();
    });
    acoes.append(a, reiniciar);
  }

  function renderizar() {
    lista.replaceChildren();
    acoes.replaceChildren();
    const r = estado.respostas;
    bolha(
      "equipe",
      `Olá! 👋 Aqui é da ${dados.nome}. Responda algumas perguntas rápidas (leva uns 2 minutos) e um contador da equipe te chama no WhatsApp com o caminho certo para o seu caso.`,
    );
    const seq = roteiro(r);
    let respondidas = 0;
    for (const p of seq) {
      if (!(p.id in r)) {
        bolha("equipe", textoPergunta(p), p.ajuda);
        p.tipo === "opcoes" ? mostrarOpcoes(p) : mostrarCampo(p);
        break;
      }
      respondidas++;
      bolha("equipe", textoPergunta(p));
      bolha("pessoa", r[p.id] ? (p.formato === "whatsapp" ? formatarWhatsapp(r[p.id]) : rotuloResposta(p, r[p.id])) : "(pulei)");
      if (p.id === "trilha") {
        const intro = trilhaPorId(r.trilha)?.intro;
        if (intro) bolha("equipe", intro);
      }
    }
    const fim = respondidas === seq.length && r.trilha !== undefined;
    if (fim) mostrarConclusao();
    // Antes de escolher o assunto, estima o total com uma trilha típica (6 perguntas)
    const total = r.trilha ? seq.length : seq.length + 6;
    progresso.style.width = `${fim ? 100 : Math.round((respondidas / total) * 100)}%`;
    voltar.disabled = respondidas === 0 || Boolean(estado.concluido);
    lista.scrollTop = lista.scrollHeight;
  }

  voltar.addEventListener("click", () => {
    const respondidas = roteiro(estado.respostas).filter((p) => p.id in estado.respostas);
    const ultima = respondidas.at(-1);
    if (!ultima) return;
    const { [ultima.id]: _removida, ...resto } = estado.respostas;
    estado.respostas = resto;
    guardar();
    renderizar();
  });

  let iniciado = false;
  function abrir() {
    painel.hidden = false;
    botao.setAttribute("aria-expanded", "true");
    botao.classList.add("hidden");
    renderizar();
    // Conclusão que não chegou ao servidor (ex.: sem internet): reenvia
    if (estado.concluido && !estado.confirmado) sincronizar(true);
    if (!iniciado) {
      iniciado = true;
      evento("qualificacao_iniciada", { pagina: location.pathname });
    }
  }

  function fechar() {
    painel.hidden = true;
    botao.setAttribute("aria-expanded", "false");
    botao.classList.remove("hidden");
  }

  document.addEventListener("click", (e) => {
    const alvo = e.target instanceof Element ? e.target : null;
    if (alvo?.closest("[data-abrir-chat]")) abrir();
    else if (alvo?.closest("[data-fechar-chat]")) fechar();
    else if (alvo?.closest("[data-evento]")) evento((alvo.closest("[data-evento]") as HTMLElement).dataset.evento ?? "", { pagina: location.pathname });
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !painel.hidden) fechar();
  });

  // Link "continuar de onde parei" do e-mail do robô de abandono
  const continuar = new URLSearchParams(location.search).get("continuar");
  if (continuar) {
    const [id, token] = continuar.split(".");
    history.replaceState(null, "", location.pathname);
    fetch(`/api/lead?id=${encodeURIComponent(id ?? "")}&token=${encodeURIComponent(token ?? "")}`)
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((lead: { id: string; token: string; status: string; respostas: Respostas }) => {
        estado = { id: lead.id, token: lead.token, respostas: lead.respostas, concluido: lead.status === "completo" };
        guardar();
      })
      .catch(() => {})
      .finally(abrir);
  }
</script>
