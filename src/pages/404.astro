---
import Base from "../layouts/Base.astro";
---

<Base titulo="Página não encontrada" descricao="A página que você procurou não existe." noindex>
  <section class="container-site max-w-2xl py-24 text-center">
    <h1 class="text-4xl font-extrabold">Página não encontrada</h1>
    <p class="mt-4 text-slate-700">O endereço pode ter mudado. Volte para o início ou fale com a gente.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="btn-secundario">Ir para o início</a>
      <button type="button" data-abrir-chat class="btn-primario">Fale com um contador</button>
    </div>
  </section>
</Base>
