---
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Qualificacao from "../components/Qualificacao.astro";
import CookieConsent from "../components/CookieConsent.astro";

import type { ComponentProps } from "astro/types";
type Props = ComponentProps<typeof Seo>;
const props = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#10284e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Resumo para assistentes de IA" />
    <Seo {...props} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:p-3">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo" class="flex-1">
      <slot />
    </main>
    <Footer />
    <Qualificacao />
    <CookieConsent />
  </body>
</html>
